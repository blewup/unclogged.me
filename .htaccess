# Déboucheur Expert - Apache Configuration
# Version 2.2.0 - cPanel Shared Hosting Optimized
# Compatible with: cPanel, CloudLinux, LiteSpeed, Apache 2.4+
# ============================================================================

# Set default handler for PHP (cPanel compatibility)
<IfModule mod_mime.c>
    AddHandler application/x-httpd-php .php
</IfModule>

# Set default charset
AddDefaultCharset UTF-8

# 4xx Client Errors - Using pages/errors/codes/ structure
ErrorDocument 400 /pages/errors/codes/400.html
ErrorDocument 401 /pages/errors/codes/401.html
ErrorDocument 403 /pages/errors/codes/403.html
ErrorDocument 404 /pages/errors/codes/404.html
ErrorDocument 405 /errors.html?code=405
ErrorDocument 408 /pages/errors/codes/408.html
ErrorDocument 410 /pages/errors/codes/410.html
ErrorDocument 429 /pages/errors/codes/429.html

# 5xx Server Errors
ErrorDocument 500 /pages/errors/codes/500.html
ErrorDocument 502 /pages/errors/codes/502.html
ErrorDocument 503 /pages/errors/codes/503.html
ErrorDocument 504 /pages/errors/codes/504.html

# Enable mod_rewrite
RewriteEngine On

# Force HTTPS in production
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Prevent directory listing
Options -Indexes

# ============================================================================
# SECURITY HEADERS
# ============================================================================

<IfModule mod_headers.c>
    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # Enable XSS filter
    Header always set X-XSS-Protection "1; mode=block"
    
    # Referrer policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Permissions policy
    Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=(), payment=()"
    
    # HSTS (1 year)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
    
    # Content Security Policy for HTML pages
    <FilesMatch "\.(html|htm)$">
        Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://unpkg.com https://generativelanguage.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https: http:; connect-src 'self' https://deboucheur.expert https://unclogged.me https://generativelanguage.googleapis.com wss:; frame-src 'self' https://www.google.com https://maps.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
    </FilesMatch>
    
    # Remove server version headers
    Header unset X-Powered-By
    Header unset Server
</IfModule>

# ============================================================================
# ACCESS CONTROL
# ============================================================================

# Block access to sensitive files
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|sql|bak|backup|old|orig|save|swp|tmp)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to hidden files
<FilesMatch "^\.(?!htaccess|well-known)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to credentials and db files directly
<FilesMatch "^(credentials|db|security)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# ============================================================================
# CACHE CONTROL
# ============================================================================

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    
    # Images - long cache
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # Fonts - long cache
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    
    # CSS & JS - medium cache
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    
    # HTML - short cache
    ExpiresByType text/html "access plus 1 hour"
    
    # JSON/API - no cache
    ExpiresByType application/json "access plus 0 seconds"
    
    # Video
    ExpiresByType video/mp4 "access plus 1 month"
    ExpiresByType video/webm "access plus 1 month"
</IfModule>

# ============================================================================
# COMPRESSION
# ============================================================================

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# ============================================================================
# PHP SETTINGS (cPanel CGI/FastCGI compatibility)
# ============================================================================

# Note: On cPanel shared hosting with CGI/FastCGI, php_* directives don't work.
# PHP settings are configured via .user.ini or php.ini in the document root.
# The settings below are for mod_php fallback only.

<IfModule mod_php.c>
    # Security
    php_flag display_errors off
    php_flag log_errors on
    php_flag expose_php off
    
    # Session security
    php_flag session.cookie_httponly on
    php_flag session.use_only_cookies on
    php_value session.cookie_samesite "Lax"
    
    # Upload limits
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_value max_execution_time 30
    php_value max_input_time 30
    php_value memory_limit 128M
</IfModule>

# LiteSpeed-specific settings (common on cPanel)
<IfModule LiteSpeed>
    RewriteEngine On
    RewriteRule .* - [E=noabort:1]
</IfModule>
