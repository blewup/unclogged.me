{
    "name": "deboucheur-expert/unclogged-me",
    "description": "Bilingual PWA for Déboucheur Expert - residential plumbing services in Montreal/Montérégie",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "Déboucheur Expert",
            "email": "info@deboucheur.expert"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-mysqli": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-curl": "*",
        "ext-fileinfo": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "classmap": [
            "api/"
        ],
        "files": [
            "api/security.php",
            "api/db.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.2"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"if (!is_dir('api/logs')) mkdir('api/logs', 0755, true);\"",
            "@php -r \"if (!is_dir('api/uploads')) mkdir('api/uploads', 0755, true);\"",
            "@php -r \"if (!is_dir('api/logs/rate-limits')) mkdir('api/logs/rate-limits', 0755, true);\""
        ],
        "post-update-cmd": [
            "@php -r \"if (!is_dir('api/logs')) mkdir('api/logs', 0755, true);\"",
            "@php -r \"if (!is_dir('api/uploads')) mkdir('api/uploads', 0755, true);\"",
            "@php -r \"if (!is_dir('api/logs/rate-limits')) mkdir('api/logs/rate-limits', 0755, true);\""
        ],
        "check": [
            "@php -l api/config.php",
            "@php -l api/contact.php",
            "@php -l api/security.php",
            "@php -l api/db.php"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
